# 依赖 / 构建产物
node_modules/
dist/

# TypeScript 增量编译缓存（npm run build 里的 tsc -b 产生）
tsconfig.tsbuildinfo

# 本地环境变量 —— **key 绝不入库**
#   .env.example 只有变量名，是入库的；.env.local 放真值，被这里忽略
.env
.env.local
.env.*.local

# 代理的本地配置（API key 放这里）
proxy/.dev.vars
proxy/.wrangler/

# playwright-cli 的快照与日志（跑完记得清）
.playwright-cli/

# 编辑器 / 系统杂项
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
