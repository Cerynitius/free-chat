# Copy this file to .env.local and fill in the real value.
# .env.local is ignored by .gitignore, so the key never lands in the repository.
#
# Build-time injection: Vite inlines every VITE_-prefixed variable into the bundle.
# Production (GitHub Pages) reads the repository secret VITE_API_KEY through CI.

# API key. It ends up inside the JS published to the public internet, so anyone
# can read it from DevTools. In proxy mode the proxy injects its own key instead.
VITE_API_KEY=

# Proxy base URL. The upstream serves no CORS headers at all, so a browser page
# cannot call it directly -- point this at the proxy from proxy/.
# Leave it empty to call the upstream directly (works only if it later enables CORS).
# Local development defaults to http://127.0.0.1:8787 when this is unset.
VITE_PROXY_URL=